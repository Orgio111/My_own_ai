# NVIDIA AI API
NVIDIA_API_KEY=nvapi-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
NVIDIA_API_BASE=https://integrate.api.nvidia.com/v1

# Default model assignments (override per task class)
MODEL_REASONING=meta/llama-3.1-nemotron-70b-instruct
MODEL_FAST=meta/llama-3.1-8b-instruct
MODEL_CODE=deepseek-ai/deepseek-coder-v2-instruct
MODEL_VISION=meta/llama-3.2-90b-vision-instruct
MODEL_EMBED=nvidia/nv-embedqa-e5-v5

# Server
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Agent
DEFAULT_AGENT_MODE=guided        # auto | guided | manual
MAX_PARALLEL_AGENTS=4
MAX_TOKENS_PER_MIN=200000

# Storage
DATA_DIR=./data
SQLITE_PATH=./data/arajim.db
VECTOR_PATH=./data/vectors.faiss

# Tooling
SHELL_ALLOWED_BIN=ls,cat,echo,pwd,git,python,pip,node,npm,curl,grep,find
SELF_MODIFY_ENABLED=false
SELF_MODIFY_BRANCH=arajim/self-improve
